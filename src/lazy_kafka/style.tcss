* {
    scrollbar-background: $background;
    scrollbar-background-hover: #121212;
    scrollbar-background-active: #121212;
    scrollbar-color: #333333;
    scrollbar-color-hover: #333333;
    scrollbar-color-active: #444444;
    scrollbar-size: 1 1;
    overflow-y: hidden;
}

Screen {
    layout: vertical;
    background: #000000;
    layers: below above;
    border: heavy red;
}

Widget {
    layer: below;
}

Tabs {
    color: $primary;
    height: 3;
    margin-top: 0;
    padding-top: 0;
}

Tabs .underline--bar {
    color: $secondary;
}

Tabs:focus .underline--bar {
    color: $secondary;
}

Tab.-active .underline--bar {
    color: $secondary;
}


Topic {
  width: auto;
}

.tablecontainer {
  max-height: 90%;
  layout: horizontal;
}


.has-scroll {
    overflow-y: auto;
}

.has-border {
    border: round $primary;
    border-title-color: $primary;
    border-subtitle-style: italic;
    border-subtitle-color: $primary;
    border-subtitle-align: right; 
}

.has-border:focus {
    border: round $primary-lighten-3;
    border-title-style: bold;
    border-title-color: $secondary;
    border-subtitle-align: left; 
}

.status-text {
    color: $text-disabled;
}
.status-text.-live {
    color: $success;
}

Status {
    height: 1;
}
Header {
	height: 1;
	dock: top;
}

Footer {
  background: $background;
  dock: top;
  height: 1;
  width: 1fr;
  overflow: hidden hidden;
}

FooterKey {
    background: $background-lighten-3;
}

FooterKey .footer-key--key {
    background: $background-lighten-3;
}

SubjectDetails {
    height: auto;
    dock: bottom;
}


CreateScreen {
    align: center middle;
}


DeleteDialog {
    align: center middle;
}

CreateDialog {
    align: center middle;
    layer: above;
    margin: 1 1;
    background: #121212;
	border: round #121212;
    border-title-style: italic;
    border-title-color: $secondary;
}

CreateDialog Grid {
    grid-size: 2 5;
    grid-rows: 1fr;
    grid-gutter: 0 1;
}

CreateDialog Input {
    column-span: 1;
    align: center middle;
}

CreateDialog Input.-valid {
        border: tall $success 60%;
    }
CreateDialog Input.-valid:focus {
    border: tall $success;
}

CreateDialog Input.-valid:focus {
    border: tall $success;
}

CreateDialog TextArea {
    column-span: 2;
    row-span: 3;
    min-height: 3fr;
    max-height: 100vh;
    border: none;
}

CreateDialog Button {
   row-span: 1;
   column-span: 1;
   align: center middle;
}

#delete-dialog {
    layer: above;
    border: round $primary;
    padding: 1 1;
	margin: 3 3;
    width: 0.8fr;
    height: 1fr;
    background: #121212;
	outline: round $warning;
}
#delete-dialog > #dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    width: 50%;
    height: 10;
}

#question {
    column-span: 2;
    height: 10;
    width: 1fr;
    content-align: left middle;
    padding: 0 1;
    color: $text-disabled;
}



Screen {
    layout: vertical;
    background: black;
}

Tabs {
    height: 3;
    margin-top: 0;
    padding-top: 0;
}


DataTable {
    height: 90%;
    width: 1fr;
}

DataTable > .datatable--odd-row {
    background: #131a2c;
}
DataTable > .datatable--even-row {
    background: #0f1525;
}

DataTable > .datatable--cursor {
    background: $secondary-darken-3;
    color: $text;
}

.datatable--header {
    background: transparent;
    color: $primary;
    text-style: bold;
}

.TabBar {
  width: 1fr;
  color: orange;
  background: #00161C;
}

Topic {
  width: auto;
  background: black;
  color: white;
  padding: 0;
  margin: 0;
  height:1;
}

MyContainer {
  max-height: 90%;
}

MyScrollableContainer {
    background: transparent;
}


Details {
   width: 1fr;
   height: auto; 
   color: yellow;
}

TopicDetails {
   width: auto;
   height: auto; 
   color: yellow;
}

Topic:focus {
  color: red;
}

TopicList {
    content-align: center middle;
    text-opacity: 60%;
    color: red;

}

MyContainer {
    layout: horizontal;
}

.box {
    width: 1fr;
    border: round $primary;
    border-subtitle-style: italic;
    border-title-color: $secondary;
    border-subtitle-color: $secondary-darken-1;
}

.initial {
    width: 0;
}



.box:focus {
    border: round $accent;
    border-title-style: bold;
    border-title-color: $secondary;
    border-subtitle-style: italic;
    border-subtitle-align: left; 
}



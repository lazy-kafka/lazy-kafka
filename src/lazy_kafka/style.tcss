$background: #000000;   /*base00*/
$primary: #5f8787;      /*base08*/
$secondary: #e78a53;    /*base0A*/
$accent: #fbcb97;
$text: #c1c1c1;         /*base05*/
$text-disabled: #333333; /*base03*/
$success: #0b6e0b;


* {
    scrollbar-background: $background;
    scrollbar-background-hover: #121212;
    scrollbar-background-active: #121212;
    scrollbar-color: #333333;
    scrollbar-color-hover: #333333;
    scrollbar-color-active: #444444;
    scrollbar-size: 1 1;
    overflow-y: hidden;
}

#base00 {
    color: #000000;
}

#base00 {
    color: #000000;
}

#base01 {
    color: #121212;
}

#base02 {
    color: #222222;
}

#base03 {
    color: #333333;
}

#base04 {
    color: #999999;
}

#base05 {
    color: #c1c1c1;
}

#base06 {
    color: #999999;
}

#base07 {
    color: #c1c1c1;
}

#base08 {
    color: #5f8787;
}

#base09 {
    color: #aaaaaa;
}

#base0A {
    color: #e78a53;
}

#base0B {
    color: #fbcb97;
}

#base0C {
    color: #aaaaaa;
}

#base0D {
    color: #888888;
}

#base0E {
    color: #999999;
}

#base0F {
    color: #444444;
}

Screen {
    layout: vertical;
    background: #000000;
    layers: below above;
}

Tabs {
    color: $primary;
    height: 3;
    margin-top: 0;
    padding-top: 0;
}

Tabs:focus .underline--bar {
    color: $primary;
}

Tab.-active {
    color: $primary;
}

Tabs .underline--bar {
    color: $primary;
}


DataTable {
    height: 90%;
    width: 1fr;
    background: #000000;
}

DataTable > .datatable--odd-row {
    background: #000000;
}
DataTable > .datatable--even-row {
    background: #0f1525;
}


.datatable--header {
    background: transparent;
    color: $primary;
    text-style: bold;
}

Topic {
  width: auto;
}

MyContainer {
  max-height: 90%;
  layout: horizontal;
}

MyScrollableContainer {
    background: transparent;
}

Pretty {
    layer: below;
}

Details {
   width: 1fr;
   height: auto; 
   color: #fbcb97;
}

Topic:focus {
  color: red;
}
.has-scroll {
    overflow-y: auto;
}

.box {
    width: 1fr;
    border: round $primary;
    border-subtitle-style: italic;
    border-title-color: $secondary;
    border-subtitle-color: $secondary-darken-1;
}

.initial {
    width: 0;
}

.box:focus {
    border: round $accent;
    border-title-style: bold;
    border-title-color: $secondary;
    border-subtitle-style: italic;
    border-subtitle-align: left; 
}

.status-text {
    color: $text-disabled;
}
.status-text.-live {
    color: $success;
}

Status {
    height: 1;
}
Header {
	height: 1;
	dock: top;
}

Footer {
  background: $background;
  dock: top;
  height: 1;
}

FooterKey {
    background: $background;
}

FooterKey .footer-key--key {
    background: $background;
}

CreateScreen {
    align: center middle;
}


Widget {
    layer: below;
}

DeleteDialog {
    align: center middle;
}

CreateDialog {
    align: center middle;
    layer: above;
    margin: 1 1;
    background: #121212;
	border: round #121212;
    border-title-style: italic;
    border-title-color: $secondary;
}

CreateDialog Grid {
    grid-size: 2 5;
    grid-rows: 1fr;
    grid-gutter: 0 1;
}

CreateDialog Input {
    column-span: 1;
    align: center middle;
}

CreateDialog Input.-valid {
        border: tall $success 60%;
    }
CreateDialog Input.-valid:focus {
    border: tall $success;
}

CreateDialog Input.-valid:focus {
    border: tall $success;
}

CreateDialog TextArea {
    column-span: 2;
    row-span: 3;
    min-height: 3fr;
    max-height: 100vh;
    border: none;
}

CreateDialog Button {
   row-span: 1;
   column-span: 1;
   align: center middle;
}

#delete-dialog {
    layer: above;
    border: round $primary;
    padding: 1 1;
	margin: 3 3;
    width: 0.8fr;
    height: 1fr;
    background: #121212;
	outline: round $warning;
}
#delete-dialog > #dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    width: 50%;
    height: 10;
}

#question {
    column-span: 2;
    height: 10;
    width: 1fr;
    content-align: left middle;
    padding: 0 1;
    color: $text-disabled;
}

